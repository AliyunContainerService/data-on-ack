# npm configuration for AI Dev Console Frontend
# Optimize npm install performance

# Use legacy peer deps to handle dependency conflicts
legacy-peer-deps=true

# Enable package-lock
package-lock=true

# Set registry (uncomment if needed)
# registry=https://registry.npmjs.org/

# Reduce network timeout for faster failures
fetch-timeout=60000
fetch-retries=2

# Enable progress bar
progress=true

# Save exact versions
save-exact=false

# Enable audit
audit=true

# Enable fund
fund=false

